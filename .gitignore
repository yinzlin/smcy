**/target/
*.db
*.db-shm
*.db-wal

# 数据库备份文件（数据迁移前的临时快照），不计入版本控制
*.db.bak*

# 主数据库需纳入版本控制（数据库结构会随功能变更）
!food_accept_v3.db

# 上传图片（商品/客户订单/签字验收单/采购单据），不计入版本控制
uploads/

# 调试日志文件
server_*.log
debug-*.log
debug-*.md
build.log

# React 前端依赖与构建产物（产物由 backend 编译期内嵌进 exe）
crates/frontend/node_modules/
crates/frontend/dist/

# 运行时产物（release build 输出），不计入版本控制
food_accept_single.exe

